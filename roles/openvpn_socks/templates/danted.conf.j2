# Dante SOCKS5 proxy; outbound via OpenVPN {{ openvpn_socks_device }}.
logoutput: stderr

internal: {{ openvpn_socks_bind }} port = {{ openvpn_socks_port }}
external: {{ openvpn_socks_device }}

socksmethod: none
clientmethod: none

user.privileged: root
user.unprivileged: nobody

client pass {
  from: 0.0.0.0/0 to: 0.0.0.0/0
  log: error
}

socks pass {
  from: 0.0.0.0/0 to: 0.0.0.0/0
  command: bind connect udpassociate
  log: error
}

socks pass {
  from: 0.0.0.0/0 to: 0.0.0.0/0
  command: bindreply udpreply
  log: error
}
